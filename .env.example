# ========================================
# Alibaba Cloud BD War Room — 環境變數設定
# ========================================
# 複製此檔案為 .env，填入真實值後執行 pnpm dev

# 【必填】PostgreSQL 資料庫連線字串
# Railway 部署時會自動提供，格式：
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@host:5432/warroom"

# 【必填】Anthropic Claude API Key
# 取得：https://console.anthropic.com/
# 用於：AI 策略生成、會議記錄分析、新聞摘要
ANTHROPIC_API_KEY="sk-ant-api03-..."

# 【選填】Telegram 通知 Bot
# 取得 Token：找 @BotFather → /newbot
# 取得 Chat ID：找 @userinfobot
# 用於：每日策略、重要事件即時推播
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 【必填】Cron 路由保護密鑰
# 隨機產生，例如：openssl rand -hex 32
# 用於：保護 /api/cron/* 路由不被外部隨意觸發
CRON_SECRET="your-random-secret-string-here"

# 【必填（部署時）】部署後的完整 URL
# Railway 部署完成後從 Dashboard 複製
# 用於：Cron Job 的 curl 目標 URL、Telegram 推播連結
WAR_ROOM_URL="https://your-app.railway.app"

# 【選填】NewsAPI.org API Key
# 取得：https://newsapi.org/register
# 用於：補充競品新聞（未實作，保留供未來使用）
NEWS_API_KEY=""
